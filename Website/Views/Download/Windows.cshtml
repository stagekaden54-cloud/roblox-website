@{
    ViewBag.Title = "BLOCK16 Windows Client";
}

<style type="text/css">
    .block16-download-page {
        max-width: 760px;
        margin: 24px auto;
        padding: 24px;
        color: #222;
        background: #fff;
        border: 1px solid #c8c8c8;
        font-family: Arial, Helvetica, sans-serif;
    }

    .block16-download-page h1 {
        margin: 0 0 8px;
        color: #174b83;
        font-size: 28px;
    }

    .block16-download-page h2 {
        margin-top: 24px;
        color: #174b83;
        font-size: 18px;
    }

    .block16-download-status {
        margin: 18px 0;
        padding: 12px 14px;
        border: 1px solid #d6a84b;
        background: #fff8e8;
        color: #604400;
    }

    .block16-download-page ul {
        padding-left: 22px;
    }

    .block16-download-link {
        display: inline-block;
        margin-top: 8px;
        padding: 10px 16px;
        background: #1c65a8;
        color: #fff !important;
        text-decoration: none;
        font-weight: bold;
        border: 1px solid #154b7e;
    }

    .block16-download-link:hover,
    .block16-download-link:focus {
        background: #174b83;
    }

    .block16-download-note {
        color: #555;
        font-size: 13px;
    }
</style>

<div class="block16-download-page">
    <h1>BLOCK16 Windows Client</h1>
    <p>Explore BLOCK16 using the dedicated Windows client.</p>

    <div class="block16-download-status" role="status">
        <strong>Public download not available yet</strong>
        <p>
            The client is still in testing. The current successful CI build is a Debug
            build and is not yet a signed, production-ready release. We will publish
            the installer or package here after release checks are complete.
        </p>
    </div>

    <h2>Release downloads</h2>
    <p>
        Official release packages will be listed on the BLOCK16 GitHub Releases page.
        Only download a package published there by the BLOCK16 project.
    </p>
    <a class="block16-download-link"
       href="https://github.com/stagekaden54-cloud/roblox-master-2016/releases"
       target="_blank"
       rel="noopener noreferrer">View BLOCK16 releases</a>

    <h2>Before installing</h2>
    <ul>
        <li>Check the release notes for supported Windows versions and system requirements.</li>
        <li>Verify the publisher and file details before running any downloaded program.</li>
        <li>Do not use unofficial mirrors or packages shared outside the project’s release page.</li>
    </ul>

    <p class="block16-download-note">
        Build status alone does not guarantee runtime compatibility, security, or publisher identity.
        Installation instructions will be added after the final package format and signing process are established.
    </p>
</div>