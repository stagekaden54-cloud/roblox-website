<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-generated, application-isolated keys are suitable only for a single
  IIS host. For a multi-server deployment, inject the same strong, unique
  validationKey and decryptionKey from a secret store on every node.
  Never commit real production keys to source control.
-->
<machineKey validationKey="AutoGenerate,IsolateApps"
            decryptionKey="AutoGenerate,IsolateApps"
            validation="HMACSHA256"
            decryption="AES" />
